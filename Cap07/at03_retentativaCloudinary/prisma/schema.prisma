generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider="postgresql"
}

// ==========================================
// TABELA: usuarios
// ==========================================
model Usuario {
  id       Int       @id @default(autoincrement())
  nome     String    @db.VarChar(100)
  cpf      String    @unique @db.Char(11)
  telefone String?   @db.VarChar(15)
  whatsapp String?   @db.VarChar(15)
  email    String    @unique @db.VarChar(100)
  senha    String    @db.VarChar(255)
  
  // Relacionamentos (O que o usuário possui)
  pets     Pet[]
  doacoes  Doacao[]

  // Diz ao Prisma o nome exato da tabela no banco
  @@map("usuarios")
}

// ==========================================
// TABELA: pets
// ==========================================
model Pet {
  id      Int       @id @default(autoincrement())
  id_cli  Int
  nome    String    @db.VarChar(50)
  sexo    String?   @db.Char(1)
  especie String    @db.VarChar(30)
  raca    String?   @db.VarChar(50)
  peso    Decimal?  @db.Decimal(5, 2)
  tamanho String?   @db.VarChar(20)
  idade   Int?
  doenca  String?   @db.VarChar(255)
  obs     String?

  // Relacionamento (Dono do Pet) - onDelete Cascade reflete seu SQL original
  usuario Usuario   @relation(fields: [id_cli], references: [id], onDelete: Cascade)
  
  // Relacionamentos
  doacoes Doacao[]
  images  PetImage[]

  @@map("pets")
}

// ==========================================
// TABELA: doacoes
// ==========================================
model Doacao {
  id               Int       @id @default(autoincrement())
  id_pet           Int
  id_cli_interesse Int?
  data_interesse   DateTime? @db.Date
  data_doacao      DateTime? @db.Date
  status           String?   @db.VarChar(50)

  // Relacionamentos e restrições
  pet              Pet       @relation(fields: [id_pet], references: [id], onDelete: Cascade)
  usuario          Usuario?  @relation(fields: [id_cli_interesse], references: [id], onDelete: SetNull)

  @@map("doacoes")
}

// ==========================================
// TABELA: imagens dos pets
// ==========================================
model PetImage {
  id        Int      @id @default(autoincrement())
  petId     Int
  url       String   @db.VarChar(500)
  publicId  String   @db.VarChar(255)
  createdAt DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_images")
}
